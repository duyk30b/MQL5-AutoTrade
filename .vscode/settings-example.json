{
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**",
    "${workspaceFolder}/Include"
  ],
  "C_Cpp.default.compilerPath": "",
  "C_Cpp.default.intelliSenseMode": "gcc-x64",
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.autocompleteAddParentheses": true,
  "files.exclude": {
    "**/*.ex4": true,
    "**/*.ex5": true,
    "**/*_@!!@.mq4": true,
    "**/*_@!!@.mq5": true,
    "**/*_@!!@.mqh": true,
    "**/*_@!!@.log": true,
    "**/*_@!@.log": true,
    "**/*_@!@.ex4": true,
    "**/*_@!@.ex5": true,
    "**/*_@!@.mq4": true,
    "**/*_@!@.mq5": true,
    "**/*_@!@.mqh": true
  },
  "files.associations": {
    "*.mqh": "cpp",
    "*.mq4": "cpp",
    "*.mq5": "cpp"
  },
  "editor.tabSize": 3,
  "C_Cpp.default.forcedInclude": [
    "/home/duy/.vscode/extensions/l-i-v.mql-tools-2.2.0/data/mql5_en.mqh"
  ],
  "mql_tools.showScrollbarColors": false,
  "workbench.tree.indent": 16,
  "explorer.compactFolders": false,
  "git.allowForcePush": true,
  "cSpell.language": "en,vi",
  "cSpell.allowCompoundWords": true,
  "cSpell.ignoreRegExpList": [
    "[àáạảãâầấậẩẫăằắặẳẵ]",
    "[èéẹẻẽêềếệểễ]",
    "[ìíịỉĩ]",
    "[òóọỏõôồốộổỗơờớợởỡ]",
    "[ùúụủũưừứựửữ]",
    "[ỳýỵỷỹđ]"
  ],
  "codemap.mq5": [
    {
      "pattern": "^\\s*class\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "clear": "{",
      "role": "class",
      "icon": "symbol-class"
    },
    {
      "pattern": "^\\s*struct\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "clear": "{",
      "role": "struct",
      "icon": "symbol-struct"
    },
    {
      "pattern": "^\\s*enum\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "clear": "{",
      "role": "enum",
      "icon": "symbol-enum"
    },
    {
      "pattern": "^\\s*(?:void|int|double|bool|string|long|datetime|color|uchar|uint|short|char|float)\\s+(?:[A-Za-z_][A-Za-z0-9_]*::)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\([^;]*\\)\\s*(?!;)",
      "clear": "{",
      "suffix": "",
      "role": "function",
      "icon": "symbol-method"
    },
    {
      "pattern": "^\\s*(?:void|int|double|bool|string|long|datetime|color|uchar|uint|short|char|float)\\s+(?:[A-Za-z_][A-Za-z0-9_]*::)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\($",
      "clear": "(",
      "suffix": "",
      "role": "function",
      "icon": "symbol-method"
    },
    {
      "pattern": "^\\s*(?!if\\b|else\\b|for\\b|while\\b|switch\\b|catch\\b)(?:[A-Za-z_][A-Za-z0-9_]*::)?(~?[A-Za-z_][A-Za-z0-9_]*)\\s*\\([^;]*\\)\\s*\\{",
      "clear": "{",
      "suffix": "",
      "role": "function",
      "icon": "symbol-constructor"
    },
    {
      "pattern": "^\\s*(?:input|extern)\\s+[A-Za-z0-9_]+\\s+([A-Za-z0-9_]+)",
      "role": "field",
      "icon": "symbol-parameter"
    }
  ],

  "codemap.mqh": [
    {
      "pattern": "^\\s*class\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "clear": "{",
      "role": "class",
      "icon": "symbol-class"
    },
    {
      "pattern": "^\\s*struct\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "clear": "{",
      "role": "struct",
      "icon": "symbol-struct"
    },
    {
      "pattern": "^\\s*enum\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "clear": "{",
      "role": "enum",
      "icon": "symbol-enum"
    },
    {
      "pattern": "^\\s*(?:void|int|double|bool|string|long|datetime|color|uchar|uint|short|char|float)\\s+(?:[A-Za-z_][A-Za-z0-9_]*::)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\([^;]*\\)\\s*(?!;)",
      "clear": "{",
      "suffix": "",
      "role": "function",
      "icon": "symbol-method"
    },
    {
      "pattern": "^\\s*(?:void|int|double|bool|string|long|datetime|color|uchar|uint|short|char|float)\\s+(?:[A-Za-z_][A-Za-z0-9_]*::)?([A-Za-z_][A-Za-z0-9_]*)\\s*\\($",
      "clear": "(",
      "suffix": "",
      "role": "function",
      "icon": "symbol-method"
    },
    {
      "pattern": "^\\s*(?!if\\b|else\\b|for\\b|while\\b|switch\\b|catch\\b)(?:[A-Za-z_][A-Za-z0-9_]*::)?(~?[A-Za-z_][A-Za-z0-9_]*)\\s*\\([^;]*\\)\\s*\\{",
      "clear": "{",
      "suffix": "",
      "role": "function",
      "icon": "symbol-constructor"
    },
    {
      "pattern": "^\\s*(?:input|extern)\\s+[A-Za-z0-9_]+\\s+([A-Za-z0-9_]+)",
      "role": "field",
      "icon": "symbol-parameter"
    }
  ]
}
